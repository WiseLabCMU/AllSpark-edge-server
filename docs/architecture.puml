@startuml
!theme plain
skinparam componentStyle uml2
skinparam Monochrome false
skinparam Nodesep 40
skinparam Ranksep 100
skinparam linetype ortho
skinparam node<<Future>> {
    borderStyle dashed
}
left to right direction

title AllSpark Edge System Architecture

node "AllSpark Perceptor Computer" as perceptor #E3F2FD {
    component "AllSpark Edge Server" as edgeserver #BBDEFB {
        port "HTTP / HTTPS" as httpport
        port "WS / WSS" as wsport
    }

    component "Agent Client\n(Autonomous Controller)" as agent #C8E6C9

    database "Video Storage" as storage #FFF9C4

    edgeserver ---> storage : Stores video files
    agent ---> httpport : Queries status and dispatches REST commands
    agent <---> wsport : Listens for Real-time Events (e.g. chunkSaved)
}

cloud "Local Network Discovery" as network #F5F5F5 {
    [mDNS / Bonjour\n(_allspark._tcp)] as bonjour
    [QR Code\n(OOB Address Scanning)] as qrcode
}

edgeserver ..> bonjour : Advertises Service
edgeserver ..> qrcode : Encodes Address

node "iOS Device" as ios_node #F3E5F5 {
    component "AllSpark iOS Client" as ios #E1BEE7
}

node "Raspberry Pi" <<Future>> as rpi_node #FFF3E0 {
    component "Potential rPi Client" as rpi #FFE0B2
}

node "Nvidia Nano" <<Future>> as nano_node #E8F5E9 {
    component "Potential Nano Client" as nano #C8E6C9
}

ios ..> bonjour : Discovers Server
ios ..> qrcode : Scans Address

' Current active protocols
ios == httpport : HTTPS
ios <==> wsport : WSS

' Planned implementations
rpi .[#red,thickness=2].> wsport : WSS
nano .[#red,thickness=2].> wsport : WSS

' Future Plans
agent .[#red,thickness=2].> ios : QUIC
agent .[#red,thickness=2].> rpi : QUIC
agent .[#red,thickness=2].> nano : QUIC

legend bottom right
  **Legend of Line Styles:**
  ----
  ..> : Service Advertisement / Discovery
  == : Current Network Protocol
  <font color=red>....></font> : Future: Pull binary video/depth via QUIC
  -- : Dashed Nodes Indicate Future Hardware Options
  --> : Internal Component Link
endlegend

@enduml
